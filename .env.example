# Base de données PostgreSQL (Neon, Supabase, ou docker-compose.yml en local)
# DATABASE_URL : connexion poolée, utilisée par l'application.
# DIRECT_URL   : connexion directe, utilisée par Prisma Migrate. Sur Neon,
# c'est la même URL que DATABASE_URL sans le suffixe "-pooler" dans le nom
# d'hôte. En local (Docker), les deux variables sont identiques.
DATABASE_URL="postgresql://maitrecoif:maitrecoif@localhost:5433/maitrecoif"
DIRECT_URL="postgresql://maitrecoif:maitrecoif@localhost:5433/maitrecoif"

# Authentification du PERSONNEL (coiffeurs + admin) : Clerk — https://dashboard.clerk.com
# Sans ces clés le site public et l'espace client marchent, mais /admin reste fermé.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/espace-equipe"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/espace-equipe/inscription"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/admin/planning"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/admin/planning"

# Authentification des CLIENTS (Auth.js) — générer avec `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"

# Email transactionnel (confirmation de RDV) — optionnel, les envois sont
# simplement loggés en console tant que RESEND_API_KEY n'est pas défini.
RESEND_API_KEY=""
RESEND_FROM="Maitre Coif <reservation@maitrecoif.fr>"

# WhatsApp — OPTIONNEL ET PAYANT (Meta facture les messages envoyés par l'entreprise).
# Laissé vide, il n'est pas utilisé : l'email est alors le seul canal client.
# (ancien commentaire :) WhatsApp (canal de confirmation de RDV) — Meta WhatsApp
# Cloud API, modèle "confirmation_rdv" à créer/approuver dans WhatsApp
# Manager. Laissez vide pour rester en mode stub (loggé en console).
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME="confirmation_rdv"
# Modèle de rappel J-1 (mêmes 5 variables que la confirmation)
WHATSAPP_REMINDER_TEMPLATE_NAME="rappel_rdv"

# SMS (alternative à WhatsApp, non branchée par défaut mais le code est
# prêt dans lib/notifications.ts) — laissez vide pour désactiver.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Anti-bot sur les formulaires publics (Cloudflare Turnstile) — optionnel,
# le honeypot + rate limiting restent actifs même sans ces clés.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Délai (en heures) avant lequel un client peut encore annuler son RDV
CANCELLATION_DEADLINE_HOURS="2"

# Fuseau horaire du salon (créneaux, jour courant, délai d'annulation)
SALON_TIMEZONE="Africa/Tunis"

# Secret de la tâche planifiée /api/cron/rappels (rappels J-1). Vercel l'envoie
# automatiquement en `Authorization: Bearer`. Générer : openssl rand -base64 32
CRON_SECRET=""

# Alertes internes pour l'équipe du salon (demande de modification, annulation
# par un client) — gratuit, tout est optionnel :
#  - Telegram : créer un bot avec @BotFather, puis récupérer l'id de la conversation
#    (envoyer un message au bot, ouvrir https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
#  - ou un simple email d'alerte :
SALON_NOTIFY_EMAIL=""
