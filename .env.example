# Base de données PostgreSQL (Neon, Supabase, ou docker-compose.yml en local)
# DATABASE_URL : connexion poolée, utilisée par l'application.
# DIRECT_URL   : connexion directe, utilisée par Prisma Migrate. Sur Neon,
# c'est la même URL que DATABASE_URL sans le suffixe "-pooler" dans le nom
# d'hôte. En local (Docker), les deux variables sont identiques.
DATABASE_URL="postgresql://maitrecoif:maitrecoif@localhost:5433/maitrecoif"
DIRECT_URL="postgresql://maitrecoif:maitrecoif@localhost:5433/maitrecoif"

# Authentification (Auth.js) — générer avec `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"

# Email transactionnel (confirmation de RDV) — optionnel, les envois sont
# simplement loggés en console tant que RESEND_API_KEY n'est pas défini.
RESEND_API_KEY=""
RESEND_FROM="Maitre Coif <reservation@maitrecoif.fr>"

# WhatsApp (canal de confirmation de RDV actif par défaut) — Meta WhatsApp
# Cloud API, modèle "confirmation_rdv" à créer/approuver dans WhatsApp
# Manager. Laissez vide pour rester en mode stub (loggé en console).
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME="confirmation_rdv"

# SMS (alternative à WhatsApp, non branchée par défaut mais le code est
# prêt dans lib/notifications.ts) — laissez vide pour désactiver.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Anti-bot sur les formulaires publics (Cloudflare Turnstile) — optionnel,
# le honeypot + rate limiting restent actifs même sans ces clés.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Délai (en heures) avant lequel un client peut encore annuler son RDV
CANCELLATION_DEADLINE_HOURS="2"
