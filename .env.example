# Base de données PostgreSQL (Neon, Supabase, ou docker-compose.yml en local)
DATABASE_URL="postgresql://maitrecoif:maitrecoif@localhost:5433/maitrecoif"

# Authentification (Auth.js) — générer avec `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"

# Email transactionnel (confirmation de RDV) — optionnel, les envois sont
# simplement loggés en console tant que RESEND_API_KEY n'est pas défini.
RESEND_API_KEY=""
RESEND_FROM="Maitre Coif <reservation@maitrecoif.fr>"

# SMS (optionnel, cf. section 2.2 du cahier des charges — hors périmètre V1
# mais le code est prêt si vous voulez l'activer) — laissez vide pour désactiver.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Anti-bot sur les formulaires publics (Cloudflare Turnstile) — optionnel,
# le honeypot + rate limiting restent actifs même sans ces clés.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Délai (en heures) avant lequel un client peut encore annuler son RDV
CANCELLATION_DEADLINE_HOURS="2"
