generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Connexion poolée (PgBouncer) utilisée par l'application à l'exécution.
  url       = env("DATABASE_URL")
  // Connexion directe utilisée par Prisma Migrate (les migrations DDL ne
  // doivent pas passer par le pooler). Sur une base locale sans pooling
  // (Docker), les deux variables pointent simplement vers la même URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  COIFFEUR
  ADMIN
}

enum StatutRendezVous {
  EN_ATTENTE
  CONFIRME
  TERMINE
  ANNULE
}

// Modélise l'héritage Utilisateur -> Coiffeur -> Administrateur du cahier des
// charges via un rôle unique : un ADMIN possède nativement les capacités
// COIFFEUR (planning, rendez-vous propres) + la gestion globale du salon.
model User {
  id             String   @id @default(uuid())
  nom            String
  prenom         String
  email          String   @unique
  telephone      String?
  motDePasseHash String
  role           Role     @default(CLIENT)
  dateCreation   DateTime @default(now())

  // Champs spécifiques Coiffeur/Administrateur (null pour un simple Client)
  // photo : data URI (redimensionnée côté client avant envoi), cf. PhotoSalon.
  photo        String?   @db.Text
  specialites  String[]  @default([])
  bio          String?
  actif        Boolean   @default(true)
  // Compte Clerk lié à cette fiche (renseigné à la première connexion) : l'accès ne dépend plus de l'email,
  // qu'on peut donc modifier sans couper l'accès du membre.
  clerkId      String?   @unique
  // Pause déjeuner (« 13:00 » – « 14:00 »), chaque jour travaillé : aucun créneau n'y est proposé.
  pauseDebut   String?
  pauseFin     String?

  disponibilites      Disponibilite[]
  rendezVousCoiffeur  RendezVous[]      @relation("RendezVousCoiffeur")
  rendezVousClient    RendezVous[]      @relation("RendezVousClient")
  resetTokens         PasswordResetToken[]
  fermetures          Fermeture[]

  @@index([role])
}

model Service {
  id          String   @id @default(uuid())
  nom         String
  description String?
  prix        Decimal  @db.Decimal(10, 2)
  duree       Int // minutes
  categorie   String?
  actif       Boolean  @default(true)

  rendezVous RendezVous[]
  lignes     RendezVousService[]
  lignesPack PackLigne[]
}

// Une prestation d'un rendez-vous. Un rendez-vous peut en contenir plusieurs
// (« Coupe » + « Barbe »). Nom, prix et durée sont copiés au moment de la
// réservation : modifier le tarif plus tard ne change pas l'historique.
// `RendezVous.serviceId` reste la première prestation (affichage de repli).
model RendezVousService {
  rendezVousId String
  rendezVous   RendezVous @relation(fields: [rendezVousId], references: [id], onDelete: Cascade)
  serviceId    String
  service      Service    @relation(fields: [serviceId], references: [id])
  ordre        Int
  nom          String
  prix         Decimal    @db.Decimal(10, 2)
  duree        Int // minutes

  @@id([rendezVousId, serviceId])
  @@index([serviceId])
}

model Disponibilite {
  id          String @id @default(uuid())
  coiffeurId  String
  coiffeur    User   @relation(fields: [coiffeurId], references: [id], onDelete: Cascade)
  jourSemaine Int // 0 = dimanche ... 6 = samedi
  heureDebut  String // "10:00"
  heureFin    String // "19:30"

  @@index([coiffeurId, jourSemaine])
}

model RendezVous {
  id           String           @id @default(uuid())
  codeSuivi    String           @unique
  coiffeurId   String
  coiffeur     User             @relation("RendezVousCoiffeur", fields: [coiffeurId], references: [id])
  serviceId    String
  service      Service          @relation(fields: [serviceId], references: [id])
  clientUserId String?
  clientUser   User?            @relation("RendezVousClient", fields: [clientUserId], references: [id])

  clientNom       String
  clientTelephone String
  clientEmail     String?

  date        DateTime // date du rendez-vous (00:00 UTC, jour civil)
  heureDebut  String // "10:00"
  heureFin    String // "10:30"
  statut      StatutRendezVous @default(EN_ATTENTE)
  notes       String?
  dateCreation DateTime        @default(now())
  // Rappel J-1 déjà envoyé (cf. /api/cron/rappels)
  rappelEnvoye Boolean         @default(false)

  lignes RendezVousService[]
  avis Avis?
  demandesModification DemandeModification[]
  commande Commande?

  @@index([coiffeurId, date])
  @@index([clientUserId])
}

model Avis {
  id           String     @id @default(uuid())
  rendezVousId String     @unique
  rendezVous   RendezVous @relation(fields: [rendezVousId], references: [id], onDelete: Cascade)
  note         Int
  commentaire  String?
  dateCreation DateTime   @default(now())
}

// Galerie de photos du salon, gérée par l'administrateur et affichée aux
// visiteurs sur le site public (accueil). L'image est stockée en base
// (data URI, redimensionnée côté client avant envoi) pour rester compatible
// avec un déploiement serverless (Vercel) sans stockage fichier externe.
model PhotoSalon {
  id           String   @id @default(uuid())
  url          String   @db.Text
  legende      String?
  ordre        Int      @default(0)
  dateCreation DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

// Compteur de tentatives partagé entre toutes les instances serverless
// (rate limiting des routes publiques et de la connexion).
model RateLimitHit {
  id        String   @id @default(uuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Congés, jours fériés et fermetures exceptionnelles. coiffeurId null =
// fermeture de tout le salon ; sinon absence d'un seul coiffeur. Bornes
// incluses (jour civil, 00:00 UTC comme RendezVous.date).
model Fermeture {
  id           String   @id @default(uuid())
  coiffeurId   String?
  coiffeur     User?    @relation(fields: [coiffeurId], references: [id], onDelete: Cascade)
  dateDebut    DateTime
  dateFin      DateTime
  motif        String?
  dateCreation DateTime @default(now())

  @@index([dateDebut, dateFin])
  @@index([coiffeurId])
}

// Demande de modification faite par un client depuis /suivi. Le rendez-vous
// reste confirmé (et son créneau bloqué) jusqu'à ce que le salon le déplace.
model DemandeModification {
  id           String     @id @default(uuid())
  rendezVousId String
  rendezVous   RendezVous @relation(fields: [rendezVousId], references: [id], onDelete: Cascade)
  message      String
  traitee      Boolean    @default(false)
  dateCreation DateTime   @default(now())

  @@index([rendezVousId, traitee])
}

// ───────────────────────── Boutique : produits, packs, réservations ─────────────────────────

enum RemisePack {
  POURCENTAGE
  PRIX_FIXE
}

enum StatutCommande {
  A_PREPARER
  PRETE
  RETIREE
  ANNULEE
  EXPIREE
}

enum TypeLigneCommande {
  PRODUIT
  PACK
}

// Produit vendu au salon, réservable en ligne puis retiré et réglé sur place.
// `stock` est décompté à la réservation et rendu si elle est annulée ou expire.
// L'image est une data URI (redimensionnée côté client), comme PhotoSalon.
model Produit {
  id           String   @id @default(uuid())
  nom          String
  description  String?
  prix         Decimal  @db.Decimal(10, 2)
  categorie    String?
  image        String?  @db.Text
  stock        Int      @default(0)
  actif        Boolean  @default(true)
  dateCreation DateTime @default(now())
  miseAJour    DateTime @updatedAt

  lignesPack     PackLigne[]
  lignesCommande CommandeLigne[]

  @@index([actif])
}

// Ensemble de prestations et de produits proposé à prix réduit. Le prix normal
// est la somme des prix actuels des éléments ; le prix du pack en découle
// (pourcentage de remise, ou prix fixe).
model Pack {
  id           String     @id @default(uuid())
  nom          String
  description  String?
  remiseType   RemisePack @default(POURCENTAGE)
  remiseValeur Decimal    @db.Decimal(10, 2)
  // Période de validité facultative (jour civil, 00:00 UTC, bornes incluses).
  debut        DateTime?
  fin          DateTime?
  actif        Boolean    @default(true)
  dateCreation DateTime   @default(now())

  lignes         PackLigne[]
  lignesCommande CommandeLigne[]

  @@index([actif])
}

// Un élément d'un pack : soit un produit, soit une prestation (jamais les deux).
model PackLigne {
  id        String   @id @default(uuid())
  packId    String
  pack      Pack     @relation(fields: [packId], references: [id], onDelete: Cascade)
  produitId String?
  produit   Produit? @relation(fields: [produitId], references: [id], onDelete: Restrict)
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  quantite  Int      @default(1)
  ordre     Int      @default(0)

  @@index([packId])
  @@index([produitId])
  @@index([serviceId])
}

// Réservation de produits et/ou de packs faite sur le site. Aucun paiement en
// ligne : le client retire et règle au salon avant `expireLe`.
model Commande {
  id              String         @id @default(uuid())
  code            String         @unique
  statut          StatutCommande @default(A_PREPARER)
  clientNom       String
  clientTelephone String
  clientEmail     String
  // 'SALON' (le client passe) ou 'RDV' (avec son prochain rendez-vous)
  retrait         String         @default("SALON")
  jourSouhaite    String?
  notes           String?
  total           Decimal        @db.Decimal(10, 2)
  economie        Decimal        @default(0) @db.Decimal(10, 2)
  expireLe        DateTime
  preteLe         DateTime?
  dateCreation    DateTime       @default(now())
  miseAJour       DateTime       @updatedAt

  // Rappel « plus que 24 h pour retirer » déjà envoyé (remis à zéro quand la commande passe à « prête »).
  rappelEnvoye    Boolean        @default(false)
  // Rendez-vous réservé en même temps (pack qui comprend une prestation).
  rendezVousId    String?        @unique
  rendezVous      RendezVous?    @relation(fields: [rendezVousId], references: [id], onDelete: SetNull)

  lignes CommandeLigne[]

  @@index([statut, dateCreation])
}

// Ligne figée au moment de la réservation (nom, prix, contenu du pack) : modifier
// le catalogue plus tard ne change pas l'historique.
model CommandeLigne {
  id                 String            @id @default(uuid())
  commandeId         String
  commande           Commande          @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  type               TypeLigneCommande
  produitId          String?
  produit            Produit?          @relation(fields: [produitId], references: [id], onDelete: SetNull)
  packId             String?
  pack               Pack?             @relation(fields: [packId], references: [id], onDelete: SetNull)
  nom                String
  quantite           Int
  prixUnitaire       Decimal           @db.Decimal(10, 2)
  prixNormalUnitaire Decimal           @db.Decimal(10, 2)
  // Contenu d'un pack : [{ type: 'produit' | 'service', produitId?, nom, quantite, prix }]
  detail             Json?

  @@index([commandeId])
  @@index([produitId])
  @@index([packId])
}
