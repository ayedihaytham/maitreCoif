# Variables d'exécution du site sur le serveur : à copier en /opt/maitre-coif/app.env (chmod 600, jamais dans Git).
# Les valeurs NEXT_PUBLIC_* sont déjà inscrites dans l'image au moment du build (variables GitHub, voir deploy/README.md) :
# les répéter ici est inutile.

# ── Base de données (le conteneur « db » du même projet) ──
# Remplacez MOT_DE_PASSE par la valeur de POSTGRES_PASSWORD du fichier .env (sans caractère spécial : lettres et chiffres).
DATABASE_URL=postgresql://maitrecoif:MOT_DE_PASSE@db:5432/maitrecoif
DIRECT_URL=postgresql://maitrecoif:MOT_DE_PASSE@db:5432/maitrecoif

# ── Authentification ──
# Clients (Auth.js) : même AUTH_SECRET que sur Vercel pour garder les sessions valides lors de la bascule.
AUTH_SECRET=
AUTH_URL=https://maitrecoif.com
# Personnel (Clerk) : les mêmes clés que sur Vercel (instance de production liée au domaine).
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_SALON_HOST=salon.maitrecoif.com

# ── Emails et alertes (mêmes valeurs que sur Vercel) ──
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
SALON_NOTIFY_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Salon ──
SALON_TIMEZONE=Africa/Tunis
CANCELLATION_DEADLINE_HOURS=2

# ── Tâche quotidienne (rappels J-1, expiration des réservations de produits) ──
# Lancée par le minuteur systemd (deploy/systemd) : le secret ne quitte pas le conteneur.
CRON_SECRET=

# ── Anti-robot (Cloudflare Turnstile), optionnel ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytique (PostHog), optionnel ──
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=
POSTHOG_INGEST_HOST=
POSTHOG_ASSETS_HOST=
NEXT_PUBLIC_POSTHOG_UI_HOST=

# ── WhatsApp / SMS (optionnels et payants) ──
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_REMINDER_TEMPLATE_NAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
