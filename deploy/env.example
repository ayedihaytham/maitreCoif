# Variables lues par Docker Compose lui-même : à copier en /opt/maitre-coif/.env (chmod 600, jamais dans Git).

# Mot de passe de la base PostgreSQL (lettres et chiffres uniquement : il est repris dans DATABASE_URL de app.env).
# Générer : openssl rand -hex 24
POSTGRES_PASSWORD=

# Image publiée par GitHub Actions (en minuscules !) : ghcr.io/<compte>/<dépôt>
IMAGE=ghcr.io/ayedihaytham/maitrecoif

# Port local du site (127.0.0.1 uniquement). À changer s'il est déjà pris par une autre application :  ss -ltn
APP_PORT=3101
